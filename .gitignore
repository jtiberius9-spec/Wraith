# Python venvs
.venv/
.venv-mac/
__pycache__/
*.pyc

# Build outputs (regenerated by PyInstaller / build_mac.sh)
build/
dist/
*.icns
*.iconset/

# Bundled runtime binaries — large; staged at build time
#   Windows: copy adb.exe(+dlls), ffmpeg.exe, scrcpy-server into bin\
#   macOS:   build_mac.sh stages them via Homebrew
bin/

# Release artifacts (published to GitHub Releases instead)
installer/
*.dmg
*.zip

# stray scratch files
_readme_backup.txt
gh_auth.log
release_notes.md

# Legacy / runtime junk
sndcpy/
*.log
*.err
*.mp4
*.pcm
*.h264
*.h265
update_url.txt
